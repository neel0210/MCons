<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="MCons" Manufacturer="Neel0210" Version="1.0.0" UpgradeCode="8a5e81f7-e592-4d2b-bbcb-79b8a5e3f1a0">
    <MajorUpgrade DowngradeErrorMessage="A newer version of MCons is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="MCons">
        <Component Id="MConsAppExe" Guid="9f8a3c21-1b2d-4e5f-a6b7-8c9d0e1f2a3b">
          <File Source="staging\mcons-app.exe" KeyPath="yes" />
        </Component>
        <Component Id="MConsCliExe" Guid="a1b2c3d4-e5f6-4a5b-8c7d-9e0f1a2b3c4d">
          <File Source="staging\mcons.exe" KeyPath="yes" />
          <Environment Id="PATH" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MCons">
        <Component Id="ApplicationShortcut" Guid="b2c3d4e5-f6a7-4b5c-8d7e-9f0a1b2c3d4e">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="MCons"
                    Description="Custom folder icons"
                    Target="[INSTALLFOLDER]mcons-app.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Neel0210\MCons" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="MCons" Level="1">
      <ComponentRef Id="MConsAppExe" />
      <ComponentRef Id="MConsCliExe" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>
  </Package>
</Wix>
